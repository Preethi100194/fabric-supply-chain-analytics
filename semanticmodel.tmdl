createOrReplace

	/// Period-over-period growth as a ratio.
	/// @param currentVal - current period value
	/// @param priorVal - prior period value
	/// @returns growth ratio (0.05 = +5%)
	function 'Supply.GrowthPct' =
			(
			        currentVal : NUMERIC,
			        priorVal : NUMERIC
			    ) =>
			    DIVIDE ( currentVal - priorVal, priorVal )
		lineageTag: 51c35d2a-1e1d-46d6-8a3a-330dcd4d4a5d

    createOrReplace

